// Modelo de datos del sistema de gestión de entrenamiento.
// Detalle y decisiones: docs/propuesta-etapa1.md
//
// Convenciones:
// - Montos en Decimal(12,2), nunca float.
// - Fechas de calendario con @db.Date (sin hora) para que la zona horaria no corra el día.
// - Los alumnos no se borran: se marcan con activo = false.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Rol {
  ADMIN
}

enum Perfil {
  DEPORTIVO
  SALUD
  RECUPERACION
}

enum TipoAnotacion {
  OBSERVACION
  CORRECCION_TECNICA
  CAMBIO_EJERCICIO
  CARGA
  MOLESTIA
  OTRO
}

enum CategoriaPrueba {
  FUERZA
  POTENCIA
  VELOCIDAD
  MOVILIDAD
  RESISTENCIA
}

enum Lado {
  IZQ
  DER
}

enum OrigenResultado {
  PLATAFORMA_FUERZA
  MYJUMP
  MANUAL
}

enum Modalidad {
  PRESENCIAL
  SEMIPRESENCIAL
  ONLINE
  OTRO
}

enum TipoBloque {
  MICROCICLOS_2_SEMANAS // bloque de 4 microciclos de 2 semanas
  MICROCICLOS_1_SEMANA // bloque de 4 microciclos de 1 semana
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
}

// ---------- Usuario y sesión ----------

model Usuario {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  nombre        String
  passwordHash  String
  rol           Rol      @default(ADMIN)
  sesiones      Sesion[]
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

// En la base se guarda solo el hash del token; el token viaja en una cookie httpOnly.
model Sesion {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash     String   @unique
  expiraEn      DateTime
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([usuarioId])
}

// ---------- Alumnos ----------

model Alumno {
  id                     Int      @id @default(autoincrement())
  nombre                 String
  apellido               String
  dni                    String   @unique
  fechaNacimiento        DateTime @db.Date
  profesion              String
  telefono               String
  email                  String?
  perfil                 Perfil
  detallePerfil          String?
  lesiones               String?
  molestias              String? // en pantalla: "Molestias/contracturas"
  actividadLaboral       String?
  otrosDatos             String?
  planId                 Int?
  plan                   Plan?    @relation(fields: [planId], references: [id])
  activo                 Boolean  @default(true)
  creadoEn               DateTime @default(now())
  actualizadoEn          DateTime @updatedAt

  cambios         CambioAlumno[]
  anotaciones     Anotacion[]
  evaluaciones    Evaluacion[]
  cuotas          Cuota[]
  pagos           Pago[]
  rutinas          Rutina[]

  @@index([apellido, nombre])
}

// Historial de cambios de la ficha: una fila por campo modificado.
// Es un registro que no se edita, por eso "fecha" cumple el rol de creadoEn.
model CambioAlumno {
  id            Int      @id @default(autoincrement())
  alumnoId      Int
  alumno        Alumno   @relation(fields: [alumnoId], references: [id])
  campo         String
  valorAnterior String?
  valorNuevo    String?
  fecha         DateTime @default(now())

  @@index([alumnoId, fecha])
}

// ---------- Anotaciones ----------

model Anotacion {
  id            Int           @id @default(autoincrement())
  alumnoId      Int
  alumno        Alumno        @relation(fields: [alumnoId], references: [id])
  fecha         DateTime      @db.Date
  tipo          TipoAnotacion
  detalle       String
  motivo        String?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  @@index([alumnoId, fecha])
}

// ---------- Evaluaciones ----------

// Catálogo de pruebas: permite comparar el mismo test a lo largo del tiempo.
model Prueba {
  id            Int                   @id @default(autoincrement())
  nombre        String                @unique
  categoria     CategoriaPrueba
  unidad        String
  // true = se carga por lado (izquierdo / derecho), ej.: movilidad de tobillo.
  porLado       Boolean               @default(false)
  activa        Boolean               @default(true)
  resultados    ResultadoEvaluacion[]
  creadoEn      DateTime              @default(now())
  actualizadoEn DateTime              @updatedAt
}

model Evaluacion {
  id            Int                   @id @default(autoincrement())
  alumnoId      Int
  alumno        Alumno                @relation(fields: [alumnoId], references: [id])
  // "Evaluación n°": numeración propia de cada alumno (1, 2, 3…). Se asigna al crearla y no cambia.
  idEvaluacion  Int
  fecha         DateTime              @db.Date
  observaciones String?
  resultados    ResultadoEvaluacion[]
  creadoEn      DateTime              @default(now())
  actualizadoEn DateTime              @updatedAt

  @@unique([alumnoId, idEvaluacion])
  @@index([alumnoId, fecha])
}

model ResultadoEvaluacion {
  id            Int             @id @default(autoincrement())
  evaluacionId  Int
  evaluacion    Evaluacion      @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  pruebaId      Int
  prueba        Prueba          @relation(fields: [pruebaId], references: [id])
  valor         Decimal         @db.Decimal(10, 2)
  unidad        String
  lado          Lado?
  origen        OrigenResultado @default(MANUAL)
  observacion   String?
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  @@index([evaluacionId])
  @@index([pruebaId])
}

// ---------- Planes y pagos ----------

// Hay un plan fijo por modalidad (Presencial, Semi presencial, Online, Otro), creado por el seed.
// Agustín solo define su precio mensual. Los cambios de plan de cada alumno quedan en CambioAlumno (campo "plan").
model Plan {
  id            Int       @id @default(autoincrement())
  nombre        String    @unique
  modalidad     Modalidad @unique
  precioMensual Decimal   @db.Decimal(12, 2)
  alumnos       Alumno[]
  cuotas        Cuota[]
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
}

// Un mes de entrenamiento (desde → vence). Se crea al registrar el pago, o con "anular deuda".
// Las cuotas se encadenan: cada una empieza donde venció la anterior (o en la reactivación del alumno).
// "importe" es lo que Agustín decide cobrar (por defecto, el precio del plan). Se paga completa, con un solo pago.
// anulada = cuota adeudada que Agustín decidió no cobrar (importe 0, sin pagos).
model Cuota {
  id            Int      @id @default(autoincrement())
  alumnoId      Int
  alumno        Alumno   @relation(fields: [alumnoId], references: [id])
  planId        Int
  plan          Plan     @relation(fields: [planId], references: [id])
  desde         DateTime @db.Date
  vence         DateTime @db.Date
  importe       Decimal  @db.Decimal(12, 2)
  anulada       Boolean  @default(false)
  pagos         Pago[]
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([alumnoId, vence])
}

// Si cuotaId es null, es un pago por otro concepto (no cuota mensual).
model Pago {
  id            Int       @id @default(autoincrement())
  alumnoId      Int
  alumno        Alumno    @relation(fields: [alumnoId], references: [id])
  cuotaId       Int?
  cuota         Cuota?    @relation(fields: [cuotaId], references: [id])
  fecha         DateTime  @db.Date
  importe       Decimal   @db.Decimal(12, 2)
  concepto      String
  medio         MedioPago
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@index([alumnoId])
  @@index([cuotaId])
  @@index([fecha])
}

// ---------- Rutinas ----------

// Rutina de entrenamiento de un alumno, armada sobre la plantilla PDF (rutina.pdf).
// No se guarda el PDF completo (pesa ~2,4 MB): se guarda lo escrito en cada campo y el PDF
// se vuelve a armar con la plantilla al verlo o descargarlo.
model Rutina {
  id            Int        @id @default(autoincrement())
  alumnoId      Int
  alumno        Alumno     @relation(fields: [alumnoId], references: [id])
  tipo          TipoBloque
  valores       Json // { "untitled1": "Pérez, Juan", "untitled2": "Adaptación", ... }
  objetivo      String? // copiado de la planilla para mostrarlo en las listas sin abrir el PDF
  // Duración del bloque, calculada por el sistema: desde = día de creación; hasta = + 2 meses (4×2 semanas) o + 1 mes (4×1 semana).
  desde         DateTime   @db.Date
  hasta         DateTime   @db.Date
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  @@index([alumnoId, creadoEn])
}
