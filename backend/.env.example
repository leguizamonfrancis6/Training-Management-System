# Copiar este archivo como ".env" y completar los valores reales.
# El archivo .env NO se sube al repositorio.

NODE_ENV=development
PORT=3000

# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Si la contraseña tiene caracteres especiales (@, #, /, :, %), hay que codificarlos (ej.: @ -> %40).
DATABASE_URL="postgresql://postgres:CAMBIAR_CONTRASEÑA@localhost:5432/entrenamiento?schema=public"
